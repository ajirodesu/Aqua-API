# -----------------------------------------------------------------------
# aqua — environment variables
#
# Copy this file to `.env` in this same directory (packages/aqua/.env)
# and fill in real values. `.env` is loaded automatically on startup by
# src/load-env.ts — nothing else to configure.
#
# See src/env.config.ts for how each variable is parsed/typed and where
# it's used.
# -----------------------------------------------------------------------

# --- Core server ---------------------------------------------------------

# Runtime mode. "development" | "production" | "test". Defaults to "development".
NODE_ENV=development

# Port the Express server listens on. Defaults to 3000.
PORT=3000

# --- Auth ------------------------------------------------------------------

# Shared secret required in the `Authorization` header for
# POST /api/notification, and as the `password` param for
# GET/POST /random/shoti2?option=add. Falls back to config.json's "key"
# field if unset.
API_KEY=

# --- Endpoint-specific API keys ---------------------------------------------

# Bearer token for the Lumenfall image-generation API.
# Used by: GET/POST /ai/lumenfall
LUMENFALL_API=

# API key for the `shoti` client. Falls back to config.json's "shotikey"
# field if unset.
# Used by: GET/POST /random/shoti
SHOTI_APIKEY=

# Pixabay API key — powers themed "Dynamic" backgrounds (Nature, Cityscape,
# Dark City, Building, Urban Street, Minimalist, Space, Futuristic) on the
# rank-up/greet cards. Free, instant sign-up: https://pixabay.com/api/docs/
# If unset, falls back to Unsplash (below), then to Lorem Picsum (no key
# needed) so "Dynamic" backgrounds always work — just without theme filtering.
# Used by: GET/POST /canvas/rankup, /canvas/greet (background=Dynamic)
PIXABAY_API_KEY=

# Unsplash API access key — secondary source for themed "Dynamic"
# backgrounds, tried when Pixabay is unset or returns no result. Free tier:
# https://unsplash.com/developers
# Used by: GET/POST /canvas/rankup, /canvas/greet (background=Dynamic)
UNSPLASH_ACCESS_KEY=

# GitHub fine-grained personal access token with the "Gists: write"
# permission, owned by whoever owns the gist below. Required for both
# reading and writing — the gist is secret, so unauthenticated requests
# get a 404.
# Used by: GET/POST /random/shoti3
GITHUB_TOKEN=

# ID of the gist storing the shoti3 TikTok URL pool. Defaults to
# 306e70b8414690012b5092a9bbfaaa85 (the gist shipped with this endpoint)
# if unset.
# Used by: GET/POST /random/shoti3
SHOTI_GIST_ID=

# Name of the file inside the shoti3 gist holding the JSON array of URLs.
# Defaults to "Shoti" if unset.
# Used by: GET/POST /random/shoti3
SHOTI_GIST_FILENAME=

# --- Advanced (rarely needed) -----------------------------------------------

# Override which .env file load-env.ts reads. Leave unset to use the
# default lookup (packages/aqua/.env, then the monorepo root .env).
# DOTENV_CONFIG_PATH=
